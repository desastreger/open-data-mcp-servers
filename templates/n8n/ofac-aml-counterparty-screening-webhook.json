            {
              "id": "cond-ofac-clear",
              "leftValue": "={{ $json.matchDecision || 'CLEAR_NO_HIT' }}",
              "rightValue": "CLEAR_NO_HIT",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"

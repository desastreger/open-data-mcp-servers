        "jsonBody": "={\n  \"queries\": {{ ($json.body?.entityName || $json.body?.companyName || $json.entityName || $json.companyName) ? JSON.stringify([$json.body?.entityName || $json.body?.companyName || $json.entityName || $json.companyName]) : \"[]\" }},\n  \"cryptoAddresses\": {{ ($json.body?.cryptoAddress || $json.cryptoAddress) ? JSON.stringify([$json.body?.cryptoAddress || $json.cryptoAddress]) : \"[]\" }},\n  \"entityType\": \"{{$json.body?.entityType || $json.entityType || 'all'}}\",\n  \"minMatchScore\": 70,\n  \"includeClearResults\": true,\n  \"maxResults\": 10\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "e5f6a7b8-0005-4000-8000-000000000002",
      "name": "Screen Counterparty via OFAC AML MCP",

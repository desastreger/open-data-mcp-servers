{
  "name": "KYB Vendor Onboarding Compliance Screening Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kyb-vendor-screen",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000001",
      "name": "Vendor Onboarding Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "kyb-vendor-screen"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/desastreger~us-kyb-compliance-dossier/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{$env.APIFY_TOKEN}}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"companies\": [\"{{$json.body.companyName || $json.companyName}}\"],\n  \"includeGleifLei\": true,\n  \"includeSecFilings\": true,\n  \"includeFdaEnforcement\": true,\n  \"includeCfpbComplaints\": true,\n  \"includeFederalAwards\": true\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000002",
      "name": "Screen Vendor via US KYB Dossier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-kyb-score",
              "leftValue": "={{ Number($json.kybVerificationScore || 0) }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000003",
      "name": "Score >= 60?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"approved\": true,\n  \"resolvedLegalName\": \"{{$json.resolvedLegalName}}\",\n  \"kybVerificationScore\": {{$json.kybVerificationScore}},\n  \"verificationStatus\": \"{{$json.verificationStatus}}\",\n  \"lei\": \"{{$json.lei || ''}}\",\n  \"primaryCik\": \"{{$json.primaryCik || ''}}\",\n  \"riskFlags\": {{ JSON.stringify($json.riskFlags || []) }}\n}",
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000004",
      "name": "Respond Approved KYB",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"approved\": false,\n  \"requiresManualReview\": true,\n  \"queriedCompany\": \"{{$json.queriedCompany}}\",\n  \"kybVerificationScore\": {{$json.kybVerificationScore || 0}},\n  \"verificationStatus\": \"{{$json.verificationStatus || 'UNVERIFIED'}}\",\n  \"riskFlags\": {{ JSON.stringify($json.riskFlags || []) }}\n}",
        "options": {}
      },
      "id": "c3d4e5f6-0003-4000-8000-000000000005",
      "name": "Respond Manual Review Required",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1000,
        400
      ]
    }
  ],
  "connections": {
    "Vendor Onboarding Webhook": {
      "main": [
        [
          {
            "node": "Screen Vendor via US KYB Dossier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Screen Vendor via US KYB Dossier": {
      "main": [
        [
          {
            "node": "Score >= 60?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Score >= 60?": {
      "main": [
        [
          {
            "node": "Respond Approved KYB",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Manual Review Required",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    {
      "name": "kyb"
    },
    {
      "name": "compliance"
    },
    {
      "name": "webhook"
    }
  ]
}
